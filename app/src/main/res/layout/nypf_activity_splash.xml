<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_splash_screen" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:src="@drawable/img_splash_line_view" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:src="@drawable/img_splash_bottom" />

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_minus10sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:scaleType="fitXY"
            android:scaleX="-1"
            android:src="@drawable/img_splash_line_view" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_splash_top" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_330sdp"
            android:layout_marginTop="@dimen/_minus50sdp"
            android:src="@drawable/img_splash_center" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginTop="@dimen/_minus10sdp"
            android:layout_marginHorizontal="@dimen/_24sdp"
            android:src="@drawable/img_splash_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:layout_marginTop="@dimen/_6sdp"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            android:text="@string/txt_splash"/>

    </LinearLayout>


</RelativeLayout>