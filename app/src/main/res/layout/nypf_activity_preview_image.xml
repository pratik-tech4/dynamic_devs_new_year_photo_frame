<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_all_screen">


    <RelativeLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivBack"
            style="@style/backButtonStyle"
            android:visibility="gone" />

        <TextView
            style="@style/headerTittleStyle"
            android:layout_centerInParent="true"
            android:text="@string/share_photo" />

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="@string/desc_btn_home"
            android:focusable="true"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_home" />

    </RelativeLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cardViewShare"
        android:layout_below="@id/rlHeader"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivImageShareView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:adjustViewBounds="true" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!--<androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/cardViewCreateAnother"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">-->

    <LinearLayout
        android:id="@+id/cardViewShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/cardViewCreateAnother"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIntsaShare"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:contentDescription="@string/desc_btn_insta"
            android:padding="@dimen/_4sdp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_share_insta" />

        <ImageView
            android:id="@+id/ivWhatsAppShare"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:contentDescription="@string/desc_btn_whatsapp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_share_whatsapp" />

        <ImageView
            android:id="@+id/ivFacebookShare"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:contentDescription="@string/desc_btn_facebook"
            android:focusable="true"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_share_facebook" />

        <ImageView
            android:id="@+id/ivShareImage"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:contentDescription="@string/desc_btn_share"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_share_image" />

    </LinearLayout>
    <!--</androidx.cardview.widget.CardView>-->

    <RelativeLayout
        android:id="@+id/cardViewCreateAnother"
        android:layout_width="@dimen/_186sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_above="@id/relativeAds"
        android:layout_centerHorizontal="true"
        android:layout_margin="@dimen/_8sdp"
        android:background="@drawable/img_btn_create_new_project">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:text="@string/create_another_photo"
            android:textColor="@color/black"
            android:textSize="@dimen/_14sdp" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/relativeAds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/relNativeAds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:orientation="horizontal"
            android:visibility="gone">

            <!--<include layout="@layout/ad_admob_native_medium"/>-->
            <!--<include layout="@layout/layout_banner_control" />-->

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
