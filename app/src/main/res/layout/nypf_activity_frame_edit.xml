<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_all_screen"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize">

            <ImageView
                android:id="@+id/ivBack"
                style="@style/backButtonStyle"
                android:layout_centerVertical="true" />

            <TextView
                style="@style/headerTittleStyle"
                android:layout_centerInParent="true"
                android:text="@string/frame_edit" />

            <ImageView
                android:id="@+id/ivSave"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:adjustViewBounds="true"
                android:clickable="true"
                android:focusable="true"
                android:onClick="onClick"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_save"
                android:visibility="gone" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rlMainFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/rlBottomNavigationNew"
            android:layout_below="@id/rlHeader"
            android:layout_centerHorizontal="true"
            android:layout_margin="@dimen/_5sdp"
            android:layout_marginStart="5dp">

            <FrameLayout
                android:id="@+id/mainFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <FrameLayout
                        android:id="@+id/photoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center">


                        <ImageView
                            android:id="@+id/photoEditorFrameView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </FrameLayout>


                    <newyearphotoframes.newyeargreetings.photoeditor.happynewyear.polish.PolishView
                        android:id="@+id/polishView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        app:showBorder="true"
                        app:showIcons="true" />

                </RelativeLayout>

                <!--<ImageView
                    android:id="@+id/ivFrameSet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    />-->

            </FrameLayout>

        </RelativeLayout>
        <!--</ScrollView>-->

        <RelativeLayout
            android:id="@+id/cvSavedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/rlBottomNavigationNew"
            android:layout_below="@id/rlHeader"
            android:background="@color/mainColor"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/flSavedImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rlFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/rlBottomNavigationNew"
            android:layout_gravity="bottom"
            android:padding="@dimen/_3sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvFilter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlSeekBarBlur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/rlBottomNavigationNew"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginBottom="@dimen/_15sdp" />

                <SeekBar
                    android:id="@+id/sbBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:max="100" />

            </LinearLayout>

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rlBottomNavigationNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">

            <!--<androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:layout_marginLeft="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:layout_toLeftOf="@+id/cvButtomSave"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_4sdp">-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:background="#17FFFFFF"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="5">

                <androidx.cardview.widget.CardView
                    style="@style/footer_button_card_view"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/llFrameBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center"
                        android:onClick="onClick"
                        android:orientation="vertical">

                        <ImageView
                            style="@style/footer_button_image_view"
                            android:src="@drawable/ic_frame" />

                        <TextView
                            style="@style/footer_button_text_view"
                            android:text="@string/frame_tag" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    style="@style/footer_button_card_view"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/llImageSelect"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center"
                        android:onClick="onClick"
                        android:orientation="vertical">

                        <ImageView
                            style="@style/footer_button_image_view"
                            android:src="@drawable/ic_add_image" />

                        <TextView
                            style="@style/footer_button_text_view"
                            android:text="Image" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    style="@style/footer_button_card_view"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/llTextBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center"
                        android:onClick="onClick"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivText"
                            style="@style/footer_button_image_view"
                            android:src="@drawable/ic_text_fields" />

                        <TextView
                            style="@style/footer_button_text_view"
                            android:text="@string/text" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    style="@style/footer_button_card_view"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/llStickerBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center"
                        android:onClick="onClick"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivSticker"
                            style="@style/footer_button_image_view"
                            android:src="@drawable/ic_sticker_fields" />

                        <TextView
                            style="@style/footer_button_text_view"
                            android:text="@string/sticker" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvButtomSave"
                    style="@style/footer_button_card_view"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/llButtomSave"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center"
                        android:onClick="onClick"
                        android:orientation="vertical">

                        <ImageView
                            style="@style/footer_button_image_view"
                            android:src="@drawable/ic_done" />

                        <TextView
                            style="@style/footer_button_text_view"
                            android:text="Save" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <!--</androidx.cardview.widget.CardView>-->


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/semi_transparent_frame_bg"
            android:paddingHorizontal="@dimen/_3sdp"
            android:paddingTop="@dimen/_50sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/scrollViewCategory" />

            <HorizontalScrollView
                android:id="@+id/scrollViewCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/linearRemainingFrameTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                </LinearLayout>

            </HorizontalScrollView>

        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clToolContianer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:focusable="true">

            <RelativeLayout
                android:id="@+id/cvAddText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/sticker_transparent_bg"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/flText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </RelativeLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relativeNativeAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="visible">

        <include layout="@layout/ads_admob_native_small" />

    </RelativeLayout>


</LinearLayout>
