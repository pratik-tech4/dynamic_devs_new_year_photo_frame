<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewYearPhotoFrame" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:includeFontPadding">false</item>
        <item name="android:statusBarColor">@color/bg_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="Theme.NewYearPhotoFrame" parent="Base.Theme.NewYearPhotoFrame"></style>

    <style name="Theme.AppCompat.crop">
        <item name="colorPrimary">@color/bg_color</item>
        <item name="colorPrimaryVariant">@color/bg_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_color</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="backButtonStyle">
        <item name="android:layout_width">@dimen/_34sdp</item>
        <item name="android:layout_height">@dimen/_34sdp</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:padding">@dimen/_3sdp</item>
        <item name="tint">@color/theme_yellow_color</item>
    </style>

    <style name="headerTittleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_34sdp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:gravity">center</item>
        <item name="paddingStart">@dimen/_10sdp</item>
        <item name="paddingEnd">@dimen/_10sdp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/_16sdp</item>
        <item name="android:textColor">@color/theme_yellow_color</item>
    </style>


    <style name="RippleStyleWhite">
        <item name="mrl_rippleOverlay">true</item>
        <item name="mrl_rippleColor">#80404040</item>
        <item name="mrl_rippleHover">true</item>
        <item name="mrl_rippleAlpha">0.5</item>
        <item name="mrl_rippleRoundedCorners">5dp</item>
        <item name="mrl_rippleDuration">250</item>
    </style>

    <style name="SCBSwitch" parent="@style/Theme.AppCompat.Light">
        <item name="android:colorForeground">#FFFFFF</item>
        <item name="colorControlActivated">@color/theme_yellow_color</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
    </style>

    <style name="footer_button_text_view">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="fontFamily">@font/poppins_medium</item>

    </style>

    <style name="footer_button_image_view">
        <item name="android:layout_width">@dimen/_18sdp</item>
        <item name="android:layout_height">@dimen/_18sdp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginBottom">@dimen/_3sdp</item>
    </style>

    <style name="footer_button_card_view">
        <item name="android:layout_width">@dimen/_45sdp</item>
        <item name="android:layout_height">@dimen/_45sdp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>

    </style>


    <style name="footer_button_linear_layout">
        <item name="android:layout_width">match_parent</item>>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="footer_button_image_view_editor">
        <item name="android:layout_width">@dimen/_18sdp</item>
        <item name="android:layout_height">@dimen/_18sdp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginBottom">@dimen/_3sdp</item>
        <item name="android:tint">@color/theme_yellow_color</item>
    </style>

    <style name="footer_button_text_view_editor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/theme_yellow_color</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="footer_button_card_view_editor">
        <item name="android:layout_width">@dimen/_45sdp</item>
        <item name="android:layout_height">@dimen/_45sdp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>

    </style>

    <style name="dialog_animation_fade">
        <item name="android:windowEnterAnimation">@anim/anim_right_in</item>
        <item name="android:windowExitAnimation">@anim/anim_right_out</item>
    </style>


</resources>